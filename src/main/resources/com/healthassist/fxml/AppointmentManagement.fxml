<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.healthassist.controller.AppointmentManagementController"
            prefWidth="1200" prefHeight="800" styleClass="dashboard-root">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          spacing="16" padding="24">

        <Label text="Appointment Management" styleClass="page-title">
            <font>
                <Font name="System Bold" size="22"/>
            </font>
        </Label>

        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <!-- Pending list -->
            <VBox styleClass="card" spacing="12" prefWidth="420" minWidth="360">
                <Label text="Pending appointments" styleClass="card-title">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Label>

                <ListView fx:id="appointmentListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Details + actions -->
            <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Appointment details" styleClass="card-title">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Label>

                <GridPane hgap="12" vgap="10">
                    <Label text="Patient:" GridPane.columnIndex="0" />
                    <Label fx:id="patientNameLabel" text="-" GridPane.columnIndex="1" />

                    <Label text="Date/Time:" GridPane.columnIndex="0" />
                    <Label fx:id="datetimeLabel" text="-" GridPane.columnIndex="1" />

                    <Label text="Status:" GridPane.columnIndex="0" />
                    <Label fx:id="statusLabel" text="-" GridPane.columnIndex="1" />

                    <Label text="Doctor:" GridPane.columnIndex="0" />
                    <Label fx:id="doctorNameLabel" text="-" GridPane.columnIndex="1" />
                </GridPane>

                <Label text="Notes / concerns (add reason here):" />
                <TextArea fx:id="notesArea" wrapText="true" editable="true" prefRowCount="6" styleClass="login-input"/>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="12">
                    <Button fx:id="confirmBtn" text="Confirm" styleClass="btn-primary" onAction="#onConfirm"/>
                    <Button fx:id="cancelBtn" text="Cancel" styleClass="btn-outline" onAction="#onCancel"/>
                    <Button fx:id="completeBtn" text="Complete" styleClass="btn-outline" onAction="#onComplete"/>
                </HBox>

                <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
