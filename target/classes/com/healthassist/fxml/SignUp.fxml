<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.healthassist.controller.SignUpController"
            prefWidth="1100" prefHeight="750"
            styleClass="login-root">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox spacing="18" alignment="TOP_CENTER">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Header -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="Create Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Label text="Register as a Patient or Doctor. OTP verification is required." wrapText="true" textAlignment="CENTER"
                       style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Main card -->
            <VBox styleClass="card" maxWidth="720" minWidth="520" spacing="14">

                <!-- Role -->
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="160"/>
                        <ColumnConstraints prefWidth="1"/>
                    </columnConstraints>

                    <Label text="Role" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <ComboBox fx:id="roleCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="combo-box" prefWidth="420"/>
                </GridPane>

                <Separator/>

                <!-- Shared fields -->
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="160"/>
                        <ColumnConstraints prefWidth="1"/>
                    </columnConstraints>

                    <Label text="Full name" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <TextField fx:id="fullNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="login-input" prefWidth="420" />

                    <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="login-input" prefWidth="420" promptText="e.g. john@example.com"/>

                    <Label text="Password" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="login-input" prefWidth="420" promptText="Minimum 6 characters"/>
                </GridPane>

                <!-- Error -->
                <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #EF4444; -fx-font-size: 13px;" />

                <!-- Patient section -->
                <VBox fx:id="patientBox" spacing="12" visible="true" managed="true">
                    <Label text="Patient details" style="-fx-font-weight: bold; -fx-text-fill: #2D5BE3; -fx-font-size: 14px;"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="160"/>
                            <ColumnConstraints prefWidth="1"/>
                        </columnConstraints>

                        <Label text="Date of birth" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="dobField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="login-input" prefWidth="420"/>

                        <Label text="Blood type" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="bloodTypeField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="login-input" prefWidth="420" promptText="e.g. O+"/>

                        <Label text="Address" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="login-input" prefWidth="420"/>

                        <Label text="Phone" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="login-input" prefWidth="420"/>

                        <Label text="Emergency contact" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="emergencyContactField" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="login-input" prefWidth="420"/>
                    </GridPane>
                </VBox>

                <!-- Doctor section -->
                <VBox fx:id="doctorBox" spacing="12" visible="false" managed="false">
                    <Label text="Doctor details" style="-fx-font-weight: bold; -fx-text-fill: #2D5BE3; -fx-font-size: 14px;"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="160"/>
                            <ColumnConstraints prefWidth="1"/>
                        </columnConstraints>

                        <Label text="Specialization" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="specializationField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="login-input" prefWidth="420"/>

                        <Label text="Hospital" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="hospitalField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="login-input" prefWidth="420"/>

                        <Label text="Rate / hour (FCFA)" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="rateField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="login-input" prefWidth="420" promptText="e.g. 15000"/>

                        <Label text="Working hours" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                        <TextField fx:id="workingHoursField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="login-input" prefWidth="420" promptText="e.g. 08:00-17:00"/>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Submit -->
                <Button fx:id="signUpBtn"
                        text="Sign Up"
                        styleClass="btn-primary"
                        prefHeight="44"
                        maxWidth="Infinity"
                        onAction="#onSignUp"/>

                <!-- Bottom -->
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 6 0 0 0;">
                    <Label text="Already have an account?" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                    <Button text="Go to Login" styleClass="btn-outline" prefHeight="38" onAction="#onGoToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
